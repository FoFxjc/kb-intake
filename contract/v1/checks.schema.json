{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/FoFxjc/kb-intake/contract/v1/checks.schema.json",
 "title": "checks.json",
 "type": "object",
 "properties": {
  "contract_version": {
   "const": "1"
  },
  "ok": {
   "type": "boolean"
  },
  "errors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "counts": {
   "type": "object"
  }
 },
 "required": [
  "contract_version",
  "ok",
  "errors",
  "counts"
 ],
 "additionalProperties": true
}
