{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/FoFxjc/kb-intake/contract/v1/page.schema.json",
 "title": "pages.jsonl row",
 "type": "object",
 "properties": {
  "page_no": {
   "type": "integer",
   "minimum": 1
  },
  "page_label": {
   "type": [
    "string",
    "null"
   ]
  },
  "kind": {
   "enum": [
    "native",
    "scanned",
    "mixed",
    "blank",
    null
   ]
  },
  "text": {
   "type": "string"
  },
  "text_source": {
   "enum": [
    "native",
    "ocr",
    "mixed"
   ]
  },
  "ocr_confidence": {
   "type": [
    "number",
    "null"
   ]
  },
  "width": {
   "type": "number"
  },
  "height": {
   "type": "number"
  },
  "docling_confidence": {
   "type": [
    "string",
    "null"
   ]
  },
  "chars": {
   "type": "integer"
  },
  "image_regions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "bbox",
     "area",
     "text_chars",
     "status"
    ],
    "properties": {
     "bbox": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
     },
     "area": {
      "type": "number"
     },
     "text_chars": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "native_text",
       "pending_ocr"
      ]
     }
    }
   }
  },
  "images_discarded": {
   "type": "integer"
  }
 },
 "required": [
  "page_no",
  "page_label",
  "kind",
  "text",
  "text_source",
  "ocr_confidence",
  "width",
  "height",
  "docling_confidence"
 ],
 "additionalProperties": true
}
