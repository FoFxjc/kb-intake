{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/FoFxjc/kb-intake/contract/v1/heading.schema.json",
 "title": "headings.jsonl row",
 "type": "object",
 "properties": {
  "region_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "page_no": {
   "type": "integer",
   "minimum": 1
  },
  "bbox": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 4,
   "maxItems": 4
  },
  "text": {
   "type": "string"
  },
  "level": {
   "type": "integer",
   "minimum": 1
  },
  "numbering": {
   "type": [
    "string",
    "null"
   ]
  },
  "sources": {
   "type": "array",
   "items": {
    "enum": [
     "font_rule",
     "numbering",
     "docling"
    ]
   }
  },
  "furniture": {
   "type": "boolean"
  }
 },
 "required": [
  "page_no",
  "bbox",
  "text",
  "level",
  "numbering",
  "sources",
  "furniture"
 ],
 "additionalProperties": true
}
