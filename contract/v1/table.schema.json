     },
     "c": {
      "type": "integer",
      "minimum": 0
     },
     "rs": {
      "type": "integer",
      "minimum": 1
     },
     "cs": {
      "type": "integer",
      "minimum": 1
     },
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "value": {
      "type": [
       "number",
       "null"
      ]
     },
