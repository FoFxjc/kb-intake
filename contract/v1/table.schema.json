   }
  },
  "pages": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1
   },
   "minItems": 1
  },
  "bboxes": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 4,
    "maxItems": 4
   },
   "minItems": 1
  },
  "n_rows": {
   "type": "integer",
