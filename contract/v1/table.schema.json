  "n_cols": {
   "type": "integer",
   "minimum": 0
  },
  "cells": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "r",
     "c",
     "rs",
     "cs",
     "text",
     "value",
     "nil",
     "bbox",
     "is_header"
    ],
    "properties": {
     "r": {
      "type": "integer",
