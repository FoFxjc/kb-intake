{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/FoFxjc/kb-intake/contract/v1/table.schema.json",
 "title": "tables.jsonl row",
 "type": "object",
 "properties": {
  "table_id": {
   "type": "string"
  },
  "region_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "pages": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1
   },
   "minItems": 1
  },
  "bboxes": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 4,
    "maxItems": 4
   },
   "minItems": 1
  },
  "n_rows": {
   "type": "integer",
   "minimum": 0
  },
  "n_cols": {
   "type": "integer",
   "minimum": 0
  },
  "cells": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "r",
     "c",
     "rs",
     "cs",
     "text",
     "value",
     "nil",
     "bbox",
     "is_header"
    ],
    "properties": {
     "r": {
      "type": "integer",
      "minimum": 0
     },
     "c": {
      "type": "integer",
      "minimum": 0
     },
     "rs": {
      "type": "integer",
      "minimum": 1
     },
     "cs": {
      "type": "integer",
      "minimum": 1
     },
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "value": {
      "type": [
       "number",
       "null"
      ]
     },
     "nil": {
      "type": "boolean"
     },
     "bbox": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "box of the text inside the cell (TOPLEFT, PDF points, full precision); null for an empty cell"
     },
     "is_header": {
      "type": "boolean"
     },
     "page_no": {
      "type": "integer",
      "minimum": 1,
      "description": "page of this cell (merged cross-page tables have cells on several pages)"
     },
     "grid_bbox": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "optional: the cell's grid box as the extractor drew it (find_tables)"
     }
    },
    "description": "One cell. rs/cs are row and column spans. extract_method=find_tables has no span information: every cell has rs = cs = 1 and grid positions covered by a merged neighbour have no cell (the owner's bbox spans them)."
   }
  },
  "header_rows": {
   "type": [
    "integer",
    "null"
   ]
  },
  "markdown": {
   "type": "string"
  },
  "extract_method": {
   "enum": [
    "docling",
    "find_tables",
    "merged"
   ]
  },
  "continued_from": {
   "type": [
    "string",
    "null"
   ]
  },
  "checks": {
   "type": "object"
  },
  "role": {
   "enum": [
    "primary",
    "secondary"
   ],
   "description": "primary = the table entered for downstream use; secondary = a candidate kept for cross-checking (e.g. find_tables next to Docling). Missing means primary."
  },
  "context_above": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text",
     "bbox"
    ],
    "properties": {
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "bbox": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
     }
    }
   },
   "description": "short lines right above the table in its columns (unit lines, notes), top to bottom; from the text layer"
  }
 },
 "required": [
  "table_id",
  "region_ids",
  "pages",
  "bboxes",
  "n_rows",
  "n_cols",
  "cells",
  "header_rows",
  "markdown",
  "extract_method",
  "continued_from",
  "checks"
 ],
 "additionalProperties": true
}
