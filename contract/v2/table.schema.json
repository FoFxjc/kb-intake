{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/FoFxjc/kb-intake/contract/v2/table.schema.json",
 "type": "object",
 "title": "tables.jsonl row (intake-design-v2 §5.5)",
 "properties": {
  "table_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]*:t[0-9]{4}_[0-9]{2}$"
  },
  "region_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]*:p[0-9]{4}:r[0-9]{3}$"
  },
  "page_no": {
   "type": "integer",
   "minimum": 1
  },
  "bbox": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 4,
   "maxItems": 4
  },
  "n_rows": {
   "type": "integer",
   "minimum": 0
  },
  "n_cols": {
   "type": "integer",
   "minimum": 0
  },
  "cells": {
   "type": "array",
   "items": {
    "type": "object",
    "title": "cell",
    "properties": {
     "r": {
      "type": "integer",
      "minimum": 0
     },
     "c": {
      "type": "integer",
      "minimum": 0
     },
     "rs": {
      "type": "integer",
      "minimum": 1
     },
     "cs": {
      "type": "integer",
      "minimum": 1
     },
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "bbox": {
      "oneOf": [
       {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
       },
       {
        "type": "null"
       }
      ]
     },
     "bbox_source": {
      "enum": [
       "text",
       "words",
       "cell",
       null
      ]
     },
     "is_header": {
      "type": "boolean"
     }
    },
    "required": [
     "r",
     "c",
     "rs",
     "cs",
     "text",
     "bbox",
     "bbox_source",
     "is_header"
    ],
    "additionalProperties": false
   }
  },
  "markdown": {
   "type": "string"
  },
  "extract_method": {
   "enum": [
    "docling",
    "find_tables"
   ]
  },
  "continued_hint": {
   "oneOf": [
    {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9._-]*:t[0-9]{4}_[0-9]{2}$"
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "table_id",
  "region_id",
  "page_no",
  "bbox",
  "n_rows",
  "n_cols",
  "cells",
  "markdown",
  "extract_method",
  "continued_hint"
 ],
 "additionalProperties": false
}
