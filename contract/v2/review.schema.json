{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/FoFxjc/kb-intake/contract/v2/review.schema.json",
 "type": "object",
 "title": "review.jsonl row (intake-design-v2 §5.9); ack rows (intake-ui-llm-design-v1 §3.4) add target and verdict",
 "properties": {
  "action": {
   "enum": [
    "reclassify",
    "exclude",
    "confirm",
    "ack"
   ]
  },
  "region_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "from": {
   "enum": [
    "title",
    "heading",
    "text",
    "list",
    "caption",
    "footnote",
    "formula",
    "toc",
    "table",
    "chart",
    "diagram",
    "picture",
    "logo",
    "icon",
    "signature",
    "stamp",
    "page_header",
    "page_footer",
    "unknown",
    "extracted",
    "discarded",
    "recorded",
    "excluded",
    "unhandled",
    null
   ]
  },
  "to": {
   "enum": [
    "title",
    "heading",
    "text",
    "list",
    "caption",
    "footnote",
    "formula",
    "toc",
    "table",
    "chart",
    "diagram",
    "picture",
    "logo",
    "icon",
    "signature",
    "stamp",
    "page_header",
    "page_footer",
    "unknown",
    "excluded",
    null
   ]
  },
  "by": {
   "type": "string"
  },
  "at": {
   "type": "string"
  },
  "note": {
   "type": [
    "string",
    "null"
   ]
  },
  "target": {
   "type": "object",
   "title": "what an ack answers (intake-ui-llm-design-v1 §3.4): a gap, a continuation hint or an LLM output",
   "properties": {
    "kind": {
     "enum": [
      "gap",
      "hint",
      "llm"
     ]
    },
    "code": {
     "type": [
      "string",
      "null"
     ]
    },
    "page_no": {
     "type": [
      "integer",
      "null"
     ]
    },
    "region_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "table_id": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "kind",
    "code",
    "page_no",
    "region_id",
    "table_id"
   ],
   "additionalProperties": false
  },
  "verdict": {
   "enum": [
    "ok",
    "wrong"
   ],
   "title": "ack only: the reviewer found the item fine (ok) or wrong; nothing is changed either way"
  }
 },
 "required": [
  "action",
  "region_id",
  "from",
  "to",
  "by",
  "at",
  "note"
 ],
 "additionalProperties": false
}
