# kb-intake settings. Copy this file to .env in the same directory and fill it in (docs/DEPLOYMENT.md, step 3).
# .env is never committed (.gitignore). ./setup.sh reads it, and so does kb-intake (CLI and serve) when started in
# this directory. A variable already set in the environment wins over the file. Relative paths are relative to this
# directory.

# ---------- where things are ----------

# The model files (docs/DEPLOYMENT.md step 2). ./setup.sh puts them into the expected layout if they are complete
# but laid out differently (a Hugging Face cache, or plain files).
INTAKE_MODELS_DIR=./models

# Jobs, cache and delivered packages go below this directory (work/, cache/, delivery/).
INTAKE_DATA_DIR=./data

# ---------- the optional LLM (an OpenAI-compatible endpoint) ----------
# Off unless INTAKE_LLM_ENABLED=true. When on, the start of every page's text (document summary) and the image and
# text of regions set to "LLM describe" are sent to INTAKE_LLM_BASE_URL. The UI, the package manifest and
# `kb-intake doctor` name that host.

INTAKE_LLM_ENABLED=false

# The base URL of the OpenAI-compatible API, usually ending in /v1 (requests go to <base>/chat/completions).
INTAKE_LLM_BASE_URL=https://llm.example.internal/v1

# The model name the endpoint serves.
INTAKE_LLM_MODEL=

# The API key (sent only in the Authorization header to INTAKE_LLM_BASE_URL; never written anywhere else).
INTAKE_LLM_API_KEY=

# Plain http:// to a host other than localhost is refused (the key would cross the network unencrypted). Set to
# true to accept that for an internal endpoint without TLS.
# INTAKE_LLM_ALLOW_HTTP=false

# Chart and picture descriptions need a model that accepts images. `kb-intake doctor` tests that on every run and
# switches descriptions off by itself when images are refused (recorded in INTAKE_DATA_DIR, not here). Set false to
# switch them off yourself.
# INTAKE_LLM_DESCRIBE=true

# ---------- the network (optional; only what your company needs) ----------

# Package mirror for ./setup.sh (pip). Without it, pip uses your existing pip configuration (pip.conf / pip.ini),
# which ./setup.sh never changes.
# PIP_INDEX_URL=https://pypi.example.internal/simple
# A mirror of PyTorch's CPU wheels (Linux: avoids the CUDA build of torch; see DEPLOYMENT.md).
# PIP_EXTRA_INDEX_URL=https://pypi.example.internal/pytorch-cpu/simple

# Proxy for pip and for the LLM requests.
# HTTPS_PROXY=http://proxy.example.internal:8080
# HTTP_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1,.example.internal

# A CA bundle (the public roots plus your company's root CA) when the company re-signs TLS. Used by the LLM client;
# ./setup.sh hands it to pip as PIP_CERT (pip does not read SSL_CERT_FILE).
# SSL_CERT_FILE=/path/to/company-ca-bundle.pem

# ---------- ./setup.sh ----------
# The environment: auto (conda when available, else a venv in ./.venv), conda or venv.
# INTAKE_ENV=auto
# The conda environment's name.
# INTAKE_CONDA_ENV=kb-intake
# The Python 3.12 used for the venv when there is no conda.
# INTAKE_PYTHON=python3.12
