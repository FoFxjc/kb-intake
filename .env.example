# Copy to .env (never committed; .env is gitignored) and fill in. kb-intake reads the INTAKE_* variables of a .env
# in the directory it runs from; a variable already set in the environment wins.

# The LLM key (intake-ui-llm-design-v1 §4). Used only when the configuration enables the LLM (llm: {enabled: true}).
# Region images and text are then sent to the configured endpoint (default https://api.minimax.io/v1).
INTAKE_LLM_API_KEY=
